# ─── IA ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ─── Base de données (Supabase) ──────────────────────────────────────────────
# URL pooler (transaction mode) — utilisée par Prisma en prod/Vercel
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=15"

# URL directe — utilisée pour les migrations Prisma (prisma db push / migrate)
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ─── Auth ────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=your-secret-32chars-minimum
# En dev :
NEXTAUTH_URL=http://localhost:3000
# En prod Vercel (remplacer par votre domaine) :
# NEXTAUTH_URL=https://your-app.vercel.app

# ─── Vercel Blob (bibliothèque collaborative — upload fichiers) ──────────────
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Obtenez une clé gratuite sur resend.com (3000 emails/mois)
RESEND_API_KEY=re_...

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Competencia IA"
